# Copy this file to .env and fill in your values.
# All values have working defaults except GEMINI_API_KEY.

# Required for AI responses (get one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-1.5-flash
# DATABASE_URL=sqlite:///./refound.db
# FRONTEND_ORIGIN=http://localhost:5173

# Hosted preview sites allowed to call this backend on localhost (see docs/DEPLOYMENT.md).
# Replace "refound" with the real Cloudflare Pages project subdomain. Empty disables.
# CORS_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?refound\.pages\.dev$
